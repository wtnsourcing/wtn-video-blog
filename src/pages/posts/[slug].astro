---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostBlocksHtml } from '../../lib/notion.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const contentHtml = await getPostBlocksHtml(post.id);
const ogImage = post.youtubeId
  ? `https://img.youtube.com/vi/${post.youtubeId}/maxresdefault.jpg`
  : "https://blog.wtnsourcing.com/assets/images/share.jpg";

// 分享链接与编码参数配置
const currentUrl = `https://blog.wtnsourcing.com/posts/${post.slug}`;
const shareTitle = encodeURIComponent(post.title || 'WTN Sourcing Insight');
const shareUrl = encodeURIComponent(currentUrl);
const shareText = encodeURIComponent(`Check out this sourcing case study from WTN Sourcing: ${post.title || ''}`);
---

<BaseLayout title={`${post.title} | WTN Sourcing`} description={post.summary} ogImage={ogImage}>
  <article style="margin-top: 3.5rem;">
    <a href="/" style="color:#0DA5DB;text-decoration:none;font-family:'Instrument Sans',sans-serif;font-weight:500;">← Back to All Video Insights</a>
    
    <div style="margin-top: 1.5rem;">
      <span class="pinned-badge">{post.section}</span>
      <h1 class="text-style-8" style="margin-top:0.5rem;">{post.title}</h1>
      <p style="font-size:0.9rem;color:rgba(22,39,60,0.45);margin-bottom:2rem;">Published on {post.date}</p>
    </div>

    {post.youtubeId && (
      <div class="video-box" style="margin-bottom: 3rem;">
        <iframe
          src={`https://www.youtube.com/embed/${post.youtubeId}?enablejsapi=1&playsinline=1&rel=0`}
          title={post.title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          playsinline
          webkit-playsinline
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          style="width: 100%; height: 100%; border: 0;"
        ></iframe>
      </div>
    )}

    {post.summary && (
      <p class="text-style-3" style="font-size:1.1rem;padding:1.5rem;background:#F4F8FB;border-left:4px solid #0DA5DB;border-radius:0.5rem;margin-bottom:2.5rem;">
        <em>{post.summary}</em>
      </p>
    )}

    <div class="notion-article-body" set:html={contentHtml} />

    <!-- 升级版专业社交与邮件分享组件 -->
    <div class="share-section">
      <span class="share-label">Share this insight:</span>
      <div class="share-buttons-group">
        <!-- LinkedIn -->
        <a 
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="share-brand-btn"
        >
          LinkedIn
        </a>

        <!-- Share on X -->
        <a 
          href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="share-brand-btn"
        >
          Share on X
        </a>

        <!-- Facebook -->
        <a 
          href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="share-brand-btn"
        >
          Facebook
        </a>

        <!-- WhatsApp -->
        <a 
          href={`https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="share-brand-btn"
        >
          WhatsApp
        </a>

        <!-- Email (邮件一键唤起并自动填入主题与正文) -->
        <a 
          href={`mailto:?subject=${shareTitle}&body=${shareText}%0A%0A${shareUrl}`} 
          class="share-brand-btn"
        >
          Email
        </a>
      </div>
    </div>
  </article>

  <style is:global>
    /* Notion 文章排版样式 */
    .notion-article-body h2 {
      font-family: 'Instrument Sans', sans-serif;
      color: #0DA5DB;
      font-size: 1.65em;
      margin: 2.5rem 0 1rem 0;
    }
    .notion-article-body h3 {
      font-family: 'Instrument Sans', sans-serif;
      color: #16273C;
      font-size: 1.3em;
      margin: 2rem 0 0.75rem 0;
    }
    .notion-article-body p {
      margin-bottom: 1.25rem;
      color: rgba(22, 39, 60, 0.75);
    }
    .notion-article-body ul, .notion-article-body ol {
      margin: 1rem 0 1.5rem 1.75rem;
      color: rgba(22, 39, 60, 0.75);
    }
    .notion-article-body li {
      margin-bottom: 0.5rem;
    }
    .notion-article-body blockquote, .notion-article-body .callout-box {
      padding: 1.25rem 1.5rem;
      background: #F4F8FB;
      border-left: 4px solid #33C4B4;
      border-radius: 0.5rem;
      margin: 1.5rem 0;
    }
    .notion-article-body .post-image {
      margin: 2.5rem 0;
      text-align: center;
    }
    .notion-article-body .post-image img {
      max-width: 100%;
      border-radius: 1.25rem;
      border: 5px solid #FFFFFF;
      box-shadow: 0rem 1.75rem 2.375rem 0rem rgba(22, 39, 60, 0.09);
    }
    .notion-article-body .post-video-frame {
      width: 100%;
      aspect-ratio: 16/9;
      border-radius: 1.25rem;
      border: 5px solid #FFFFFF;
      box-shadow: 0rem 1.75rem 2.375rem 0rem rgba(22, 39, 60, 0.09);
      overflow: hidden;
      margin: 2rem 0;
    }
    .notion-article-body .post-video-frame iframe, .notion-article-body .post-video-frame video {
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* 专业品牌青蓝渐变分享按钮样式 */
    .share-section {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.25rem;
      margin: 3.5rem 0 2rem 0;
      padding-top: 2rem;
      border-top: 1px solid rgba(22, 39, 60, 0.1);
    }
    .share-label {
      font-family: 'Instrument Sans', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      color: #171515;
      letter-spacing: -0.01em;
    }
    .share-buttons-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }
    .share-brand-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.55rem 1.4rem;
      font-family: 'Instrument Sans', 'Inter', -apple-system, sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: #FFFFFF !important;
      background: linear-gradient(135deg, #22C5B3 0%, #0DA5DB 100%);
      border-radius: 9999px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(13, 165, 219, 0.28);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }
    .share-brand-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(13, 165, 219, 0.4);
      filter: brightness(1.06);
      color: #FFFFFF !important;
      text-decoration: none;
    }
    .share-brand-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 8px rgba(13, 165, 219, 0.3);
    }
    @media (max-width: 768px) {
      .share-section {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      .share-buttons-group {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
